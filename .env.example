# Culture Feedback — Environment Configuration Example
# Copy to .env and fill in your organization's credentials.
# Never commit real secrets to version control.

K_ANONYMITY_THRESHOLD=5
DEFAULT_PROVIDER=simulator

# Microsoft Entra ID (Azure AD) App Registration for Microsoft Graph API
# Required Application Permissions (Least Privilege):
# - User.Read.All (to read user directory, department, and manager hierarchy)
# - Calendars.Read (to read calendarView metadata; raw body text is stripped in memory)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Outbound Microsoft Teams Incoming Webhook / Workflows URL
# Must be HTTPS on a trusted Microsoft Teams / Power Platform domain
MS_TEAMS_WEBHOOK_URL=

# Optional shared secret for verifying inbound Adaptive Card Action.Submit callbacks
MS_BOT_SHARED_SECRET=

# Set to "false" when connecting to a live Azure AD tenant & Teams Webhook
MS_GRAPH_DRY_RUN=true
